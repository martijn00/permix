{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "100%",
  "cacheMaxAge": "14d",
  "cacheMaxSize": "10GB",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**",
        ".output/**"
      ]
    },
    "check-types": {
      "dependsOn": ["transit", "permix#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "jit",
          "globs": [".source/**"]
        }
      ]
    },
    "test": {
      "dependsOn": ["transit", "permix#build"]
    }
  }
}
